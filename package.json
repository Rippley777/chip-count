{
  "name": "chip-count",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n core,ui \"npm:dev:core\" \"npm:dev:ui\"",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:core": "cargo run -p chip-server",
    "pricing:refresh": "cargo run -p chip-server -- --refresh-prices",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "playwright test",
    "test:rust": "cargo test -p chip-core",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write src tests *.ts *.json index.html && cargo fmt --all",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "macos:doctor": "node scripts/macos-release.mjs doctor",
    "macos:credentials": "node scripts/macos-release.mjs credentials",
    "macos:build": "node scripts/macos-release.mjs build",
    "macos:package": "node scripts/macos-release.mjs package",
    "macos:notarize": "node scripts/macos-release.mjs notarize",
    "macos:staple": "node scripts/macos-release.mjs staple",
    "macos:verify": "node scripts/macos-release.mjs verify",
    "macos:notarization:log": "node scripts/macos-release.mjs log",
    "macos:release": "node scripts/macos-release.mjs release",
    "macos:release:universal": "node scripts/macos-release.mjs release --target universal-apple-darwin",
    "test:release": "node --test scripts/macos-release.test.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "appstore:local": "node scripts/appstore.mjs local",
    "appstore:build": "node scripts/appstore.mjs build",
    "appstore:package": "node scripts/appstore.mjs package",
    "appstore:verify": "node scripts/appstore.mjs verify",
    "test:appstore": "node --test scripts/appstore.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "typescript-eslint": "^8.35.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
